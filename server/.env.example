PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gigcraft?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_string_of_48_or_more_characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_DAYS=7
CLIENT_URL=http://localhost:5173

# lax (default, same-site) | none (only for a frontend on a different domain, needs HTTPS)
COOKIE_SAME_SITE=lax
# Set to 1 when behind a proxy such as Render
TRUST_PROXY=0
# Raise these in dev if you run the smoke test repeatedly
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=300
# true = Express also serves client/dist (single-service deployment)
SERVE_CLIENT=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=