PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_DAYS=7
CLIENT_URL=http://localhost:5173
# lax (default, same-site) | none (only for a frontend on a different domain, needs HTTPS)
COOKIE_SAME_SITE=lax
# Set to 1 when behind a proxy such as Render
TRUST_PROXY=0
# Raise these in dev if you run the smoke test repeatedly
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=300
# true = Express also serves client/dist (single-service deployment)
SERVE_CLIENT=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password-reset emails use Brevo's HTTPS API (Render's free tier blocks SMTP).
# Leave BREVO_API_KEY empty to print emails in the server console instead (development).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=GigCraft