# Leave unset in development (Vite proxies /api to the server) and for single-service deployment.
# Only set this when the API is on a different domain, e.g. https://api.example.com/api
# VITE_API_URL=https://freelance-marketplace-react.onrender.com

VITE_API_URL=

# Shown on the Help, Terms and Privacy pages as the contact address (optional).
# Vite reads this at build time, so on Render set it before the deploy runs.
VITE_CONTACT_EMAIL=